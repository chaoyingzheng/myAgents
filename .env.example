# Your W&B API key (https://wandb.ai/settings). Used for Weave, Serverless Inference, and Sandboxes.
WANDB_API_KEY=

# Weave project as "<entity>/<project>". Entity = your W&B *team* entity (not the "-org" name).
WEAVE_PROJECT=your-team-entity/mathAgent

# Any chat model listed by `python scripts/smoke_test.py` (CoreWeave Serverless Inference)
MODEL_ID=Qwen/Qwen3.6-35B-A3B
